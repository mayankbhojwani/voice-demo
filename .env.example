# Copy to .env and fill in. Never commit .env.

# Which LLM backend the pipeline uses: ollama | openrouter  (used from M2)
LLM_BACKEND=ollama

# Local Ollama (M2+)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=priya-qwen3

# Hosted run via OpenRouter (M7 only; leave blank until then)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# STT backend: local (MLX Whisper) | gnani (hosted streaming STT)
STT_BACKEND=local
# Put your real key only in .env, never here
GNANI_API_KEY=
